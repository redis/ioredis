{
  "branches": [
    {
      "name": "main",
      "tag": "latest"
    },
    {
      "name": "beta",
      "channel": "beta",
      "tag": "beta",
      "prerelease": "beta"
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "parserOpts": {
          "noteKeywords": ["BREAKING CHANGE", "BREAKING CHANGES", "BREAKING"]
        }
      }
    ],
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/npm", { "npmPublish": false }],
    [
      "@semantic-release/exec",
      {
        "verifyConditionsCmd": "test -n '${branch.tag}' || { echo 'No npm dist-tag configured for branch ${branch.name}' >&2; exit 1; }",
        "prepareCmd": "node bin/generate-version.js",
        "publishCmd": "npm stage publish --tag ${branch.tag} --provenance"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json",
          "package-lock.json",
          "CHANGELOG.md",
          "docs/**/*",
          "lib/utils/version.ts"
        ]
      }
    ],
    "@semantic-release/github"
  ]
}
